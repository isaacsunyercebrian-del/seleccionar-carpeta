{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .mt-head { text-align: center; margin-left:auto; margin-right:auto; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-pasos mt-section">
  <div class="mt-container">
    <div class="mt-head mt-head--center mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="mt-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lead != blank -%}<p class="mt-lead">{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="mt-steps">
      {%- for block in section.blocks -%}
        <div class="mt-step mt-reveal" style="--mt-delay: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
          <span class="mt-step__n">{{ forloop.index }}</span>
          <h3 class="mt-step__t">{{ block.settings.title }}</h3>
          <p class="mt-step__d">{{ block.settings.text | newline_to_br }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUMINA · Pasos de uso",
  "tag": "section",
  "max_blocks": 5,
  "blocks": [
    { "type": "paso", "name": "Paso", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Paso" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Describe el paso." }
    ] }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Listo en 10 segundos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tan fácil como pegar y encender" },
    { "type": "textarea", "id": "lead", "label": "Texto de apoyo", "default": "Sin taladros, sin cables, sin electricista. Tú mismo en menos de un minuto." },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#0e0c0b" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [ { "name": "LUMINA · Pasos de uso", "blocks": [
    { "type": "paso", "settings": { "title": "Cárgala", "text": "Conecta el cable USB-C incluido. En un par de horas está lista para semanas." } },
    { "type": "paso", "settings": { "title": "Pégala o imántala", "text": "Coloca la base adhesiva o magnética donde quieras. Se alinea en un segundo." } },
    { "type": "paso", "settings": { "title": "Disfruta la luz", "text": "Elige tono y brillo. A partir de ahí, se enciende sola cuando te acercas." } }
  ] } ]
}
{% endschema %}
