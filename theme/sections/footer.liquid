{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<footer class="mt-footer mt-section">
  <div class="mt-container">
    <div class="mt-footer__grid">
      <div class="mt-footer__brand">
        <span class="mt-wordmark">{{ section.settings.brand_name | default: 'Lumina' }}</span>
        {%- if section.settings.tagline != blank -%}
          <p class="mt-footer__tag">{{ section.settings.tagline | newline_to_br }}</p>
        {%- endif -%}
        <div class="mt-footer__social">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'mt-icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'mt-icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'mt-icon', name: 'facebook' %}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="mt-footer__col">
        <h4>{{ section.settings.nav_title | default: 'Tienda' }}</h4>
        <ul>
          {%- if section.settings.nav1_label != blank -%}<li><a href="{{ section.settings.nav1_link | default: '#' }}">{{ section.settings.nav1_label }}</a></li>{%- endif -%}
          {%- if section.settings.nav2_label != blank -%}<li><a href="{{ section.settings.nav2_link | default: '#' }}">{{ section.settings.nav2_label }}</a></li>{%- endif -%}
          {%- if section.settings.nav3_label != blank -%}<li><a href="{{ section.settings.nav3_link | default: '#' }}">{{ section.settings.nav3_label }}</a></li>{%- endif -%}
          {%- if section.settings.nav4_label != blank -%}<li><a href="{{ section.settings.nav4_link | default: '#' }}">{{ section.settings.nav4_label }}</a></li>{%- endif -%}
        </ul>
      </div>

      <div class="mt-footer__col">
        <h4>{{ section.settings.legal_title | default: 'Información' }}</h4>
        <ul>
          {%- if section.settings.legal1_label != blank -%}<li><a href="{{ section.settings.legal1_link | default: '/policies/privacy-policy' }}">{{ section.settings.legal1_label }}</a></li>{%- endif -%}
          {%- if section.settings.legal2_label != blank -%}<li><a href="{{ section.settings.legal2_link | default: '/policies/terms-of-service' }}">{{ section.settings.legal2_label }}</a></li>{%- endif -%}
          {%- if section.settings.legal3_label != blank -%}<li><a href="{{ section.settings.legal3_link | default: '/policies/refund-policy' }}">{{ section.settings.legal3_label }}</a></li>{%- endif -%}
          {%- if section.settings.legal4_label != blank -%}<li><a href="{{ section.settings.legal4_link | default: '/policies/shipping-policy' }}">{{ section.settings.legal4_label }}</a></li>{%- endif -%}
        </ul>
      </div>
    </div>

    <div class="mt-footer__bar">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Lumina' }}. {{ section.settings.rights | default: 'Todos los derechos reservados.' }}</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="mt-footer__pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Nombre de la marca", "default": "Lumina" },
    { "type": "textarea", "id": "tagline", "label": "Frase de marca", "default": "Luz cálida e inteligente para cada rincón de tu hogar. Sin obras, sin cables." },
    { "type": "header", "content": "Redes sociales" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "header", "content": "Columna de navegación" },
    { "type": "text", "id": "nav_title", "label": "Título", "default": "Tienda" },
    { "type": "text", "id": "nav1_label", "label": "Enlace 1 · texto", "default": "Inicio" },
    { "type": "url", "id": "nav1_link", "label": "Enlace 1 · destino" },
    { "type": "text", "id": "nav2_label", "label": "Enlace 2 · texto", "default": "La luz LED" },
    { "type": "url", "id": "nav2_link", "label": "Enlace 2 · destino" },
    { "type": "text", "id": "nav3_label", "label": "Enlace 3 · texto", "default": "Todos los productos" },
    { "type": "url", "id": "nav3_link", "label": "Enlace 3 · destino" },
    { "type": "text", "id": "nav4_label", "label": "Enlace 4 · texto", "default": "Contacto" },
    { "type": "url", "id": "nav4_link", "label": "Enlace 4 · destino" },
    { "type": "header", "content": "Columna legal" },
    { "type": "text", "id": "legal_title", "label": "Título", "default": "Información" },
    { "type": "text", "id": "legal1_label", "label": "Legal 1 · texto", "default": "Privacidad" },
    { "type": "url", "id": "legal1_link", "label": "Legal 1 · destino" },
    { "type": "text", "id": "legal2_label", "label": "Legal 2 · texto", "default": "Términos del servicio" },
    { "type": "url", "id": "legal2_link", "label": "Legal 2 · destino" },
    { "type": "text", "id": "legal3_label", "label": "Legal 3 · texto", "default": "Devoluciones" },
    { "type": "url", "id": "legal3_link", "label": "Legal 3 · destino" },
    { "type": "text", "id": "legal4_label", "label": "Legal 4 · texto", "default": "Envíos" },
    { "type": "url", "id": "legal4_link", "label": "Legal 4 · destino" },
    { "type": "header", "content": "Barra inferior" },
    { "type": "text", "id": "rights", "label": "Texto de derechos", "default": "Todos los derechos reservados." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
