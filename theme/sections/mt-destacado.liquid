{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-destacado mt-section">
  <div class="mt-container">
    <div class="mt-split {% if section.settings.reverse %}mt-split--reverse{% endif %}">
      <div class="mt-split__media mt-reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
        {%- else -%}
          <img src="{{ 'mt-destacado.jpg' | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>

      <div class="mt-split__text mt-reveal" style="--mt-delay: 0.1s">
        {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="mt-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="mt-lead">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}

        {%- assign feats = section.settings.features | newline_to_br | split: '<br />' -%}
        {%- if section.settings.features != blank -%}
          <ul class="mt-feat">
            {%- for f in feats -%}
              {%- assign ff = f | strip -%}
              {%- if ff != blank -%}<li>{% render 'mt-icon', name: 'check' %}<span>{{ ff }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.btn_label != blank -%}
          <div style="margin-top:30px">
            <a class="mt-btn mt-btn--primary" href="{{ section.settings.btn_link | default: '#' }}">{{ section.settings.btn_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUMINA · Destacado",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "checkbox", "id": "reverse", "label": "Imagen a la derecha", "default": false },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "La magia de la luz automática" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Entras, y la luz ya está ahí" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Abres el armario de noche y se ilumina solo. Vas a la cocina y el rincón se enciende a tu paso. Sin interruptores, sin buscar a tientas." },
    { "type": "textarea", "id": "features", "label": "Lista de ventajas (una por línea)", "default": "Detecta el movimiento a 3 metros y 120°\nSe apaga sola para ahorrar batería\nModo noche: luz suave solo en penumbra\nInstalación en 10 segundos, sin herramientas" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "btn_label", "label": "Texto del botón", "default": "Quiero la mía" },
    { "type": "url", "id": "btn_link", "label": "Enlace del botón" },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#17120e" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [ { "name": "LUMINA · Destacado" } ]
}
{% endschema %}
