{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .mt-head { text-align: center; margin-left:auto; margin-right:auto; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-faqsec mt-section">
  <div class="mt-container">
    <div class="mt-head mt-head--center mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="mt-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="mt-faq">
      {%- for block in section.blocks -%}
        <div class="mt-faq__item mt-reveal" {{ block.shopify_attributes }}>
          <button class="mt-faq__q" type="button" aria-expanded="false">
            <span>{{ block.settings.q }}</span>
            {% render 'mt-icon', name: 'plus' %}
          </button>
          <div class="mt-faq__a">
            <p>{{ block.settings.a | newline_to_br }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUMINA · Preguntas",
  "tag": "section",
  "max_blocks": 12,
  "blocks": [
    { "type": "pregunta", "name": "Pregunta", "settings": [
      { "type": "text", "id": "q", "label": "Pregunta", "default": "¿Pregunta?" },
      { "type": "textarea", "id": "a", "label": "Respuesta", "default": "Respuesta." }
    ] }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Resolvemos tus dudas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#0e0c0b" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [ { "name": "LUMINA · Preguntas", "blocks": [
    { "type": "pregunta", "settings": { "q": "¿Necesita cables o enchufe?", "a": "No. Es totalmente inalámbrica y se recarga por USB-C. Una carga dura varias semanas con un uso normal." } },
    { "type": "pregunta", "settings": { "q": "¿Cómo se sujeta?", "a": "Incluye base adhesiva y soporte magnético. Puedes pegarla o imantarla y quitarla cuando quieras, sin dañar la superficie." } },
    { "type": "pregunta", "settings": { "q": "¿De verdad se enciende sola?", "a": "Sí. El sensor detecta el movimiento hasta 3 metros y se apaga sola a los pocos segundos para ahorrar batería. También tiene modo de luz fija." } },
    { "type": "pregunta", "settings": { "q": "¿Qué tamaño elijo?", "a": "20-30 cm para cajones, mesitas y estantes; 40-50 cm para encimeras, pasillos y armarios grandes. Puedes combinar varias." } },
    { "type": "pregunta", "settings": { "q": "¿Cuánto tarda el envío?", "a": "Lo preparamos en 24h y suele llegar en 24-72h. El envío es gratuito a toda la península." } }
  ] } ]
}
{% endschema %}
