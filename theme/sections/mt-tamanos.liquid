{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .mt-head { text-align: center; margin-left:auto; margin-right:auto; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-tamanos mt-section">
  <div class="mt-container">
    <div class="mt-head mt-head--center mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="mt-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lead != blank -%}<p class="mt-lead">{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="mt-sizes">
      {%- for block in section.blocks -%}
        <div class="mt-size mt-reveal" style="--mt-delay: {{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
          <div class="mt-size__bar" style="width: {{ block.settings.bar_width }}%"></div>
          <div class="mt-size__n">{{ block.settings.size }}</div>
          <p class="mt-size__d">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUMINA · Tamaños",
  "tag": "section",
  "max_blocks": 6,
  "blocks": [
    { "type": "tamano", "name": "Tamaño", "settings": [
      { "type": "text", "id": "size", "label": "Medida", "default": "20 cm" },
      { "type": "text", "id": "text", "label": "Texto", "default": "Para rincones pequeños" },
      { "type": "range", "id": "bar_width", "label": "Largo de la barra", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 40 }
    ] }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "A tu medida" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige el tamaño perfecto" },
    { "type": "textarea", "id": "lead", "label": "Texto de apoyo", "default": "Cuatro largos para que encaje en cualquier espacio, del cajón al armario entero." },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#17120e" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [ { "name": "LUMINA · Tamaños", "blocks": [
    { "type": "tamano", "settings": { "size": "20 cm", "text": "Cajones y estantes", "bar_width": 40 } },
    { "type": "tamano", "settings": { "size": "30 cm", "text": "Mesitas y vitrinas", "bar_width": 60 } },
    { "type": "tamano", "settings": { "size": "40 cm", "text": "Encimeras y pasillos", "bar_width": 80 } },
    { "type": "tamano", "settings": { "size": "50 cm", "text": "Armarios y espacios grandes", "bar_width": 100 } }
  ] } ]
}
{% endschema %}
