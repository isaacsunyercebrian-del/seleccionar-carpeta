{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .mt-head { text-align: center; margin-left:auto; margin-right:auto; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-usos mt-section">
  <div class="mt-container">
    <div class="mt-head mt-head--center mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="mt-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lead != blank -%}<p class="mt-lead">{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="mt-uses__grid">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index0 | modulo: 4 -%}
        {%- case idx -%}
          {%- when 0 -%}{%- assign fb = 'mt-uso-armario.jpg' -%}
          {%- when 1 -%}{%- assign fb = 'mt-uso-salon.jpg' -%}
          {%- when 2 -%}{%- assign fb = 'mt-uso-recargable.jpg' -%}
          {%- else -%}{%- assign fb = 'mt-uso-pasillo.jpg' -%}
        {%- endcase -%}
        <div class="mt-use mt-reveal" style="--mt-delay: {{ forloop.index0 | times: 0.07 }}s" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label | escape }}" loading="lazy">
          {%- else -%}
            <img src="{{ fb | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy">
          {%- endif -%}
          <div class="mt-use__scrim"></div>
          <div class="mt-use__label">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUMINA · Dónde usarla",
  "tag": "section",
  "max_blocks": 8,
  "blocks": [
    { "type": "uso", "name": "Uso", "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen" },
      { "type": "text", "id": "label", "label": "Etiqueta", "default": "Armario" }
    ] }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Va contigo a todas partes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Un rincón oscuro en cada casa" },
    { "type": "textarea", "id": "lead", "label": "Texto de apoyo", "default": "Donde no llega un enchufe, llega Lumina. Elige dónde la pones y disfruta la luz." },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#17120e" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [ { "name": "LUMINA · Dónde usarla", "blocks": [
    { "type": "uso", "settings": { "label": "Armarios y vestidores" } },
    { "type": "uso", "settings": { "label": "Cocina y estantes" } },
    { "type": "uso", "settings": { "label": "Recargable, sin enchufe" } },
    { "type": "uso", "settings": { "label": "Pasillos y escaleras" } }
  ] } ]
}
{% endschema %}
