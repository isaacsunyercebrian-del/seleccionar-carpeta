{%- comment -%} Iconos de línea reutilizables. Uso: {% render 'mt-icon', name: 'motion' %} {%- endcomment -%}
{%- liquid
  assign n = name | default: 'check'
-%}
{%- case n -%}
{%- when 'check' -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
{%- when 'motion' -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="4.5" r="1.6"/><path d="M8 9.5 5.5 12M9 8l3 2 2.5-1M9 8l-.5 5 2.5 4M9 13l-2.5 4"/><path d="M15.5 7.5a6 6 0 0 1 0 9M18.5 5a9.5 9.5 0 0 1 0 14" opacity="0.6"/></svg>
{%- when 'usb' -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v15"/><path d="M12 17a3 3 0 0 0 3-3V9"/><path d="M9 7l3-3 3 3"/><circle cx="15" cy="7.5" r="1.3" fill="currentColor" stroke="none"/><rect x="9.5" y="17" width="5" height="5" rx="1.4"/></svg>
{%- when 'magnet' -%}
